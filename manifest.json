{
  "schemaVersion": 1,
  "id": "io.github.jmr85.taskbar",
  "name": "Taskbar+",
  "version": "1.0.0",
  "author": "Juan Martin Ruiz",
  "license": "MIT",
  "description": "Pinned apps for the Omarchy bar with hover window previews and click-to-focus, scroll-to-cycle, running-app highlights, window-count badges, workspace and close-window actions, and English/Spanish strings.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Taskbar+",
    "description": "Pinned apps with running highlights, hover previews and window actions; left = launch or focus, wheel = cycle windows, right = actions, middle = new instance",
    "category": "Launcher",
    "allowMultiple": false,
    "defaultSection": "left",
    "defaults": {
      "apps": [],
      "iconSize": 17,
      "spacing": 2,
      "runningIndicator": true,
      "highlightRunning": true,
      "windowCountBadge": true,
      "dimWhenClosed": true,
      "cycleWindows": true,
      "wheelCycles": true,
      "previewOnHover": true,
      "showAddButton": true,
      "showRunningApps": true
    },
    "schema": [
      {
        "key": "apps",
        "type": "array",
        "label": "Pinned apps"
      },
      {
        "key": "iconSize",
        "type": "number",
        "label": "Icon size (px)"
      },
      {
        "key": "spacing",
        "type": "number",
        "label": "Gap between icons (px)"
      },
      {
        "key": "runningIndicator",
        "type": "bool",
        "label": "Show running indicator"
      },
      {
        "key": "highlightRunning",
        "type": "bool",
        "label": "Tint icons of running apps"
      },
      {
        "key": "windowCountBadge",
        "type": "bool",
        "label": "Show a badge when an app has several windows"
      },
      {
        "key": "dimWhenClosed",
        "type": "bool",
        "label": "Dim icons for apps that are not running"
      },
      {
        "key": "cycleWindows",
        "type": "bool",
        "label": "Re-clicking a focused app cycles its windows"
      },
      {
        "key": "wheelCycles",
        "type": "bool",
        "label": "Scrolling over an icon cycles its windows"
      },
      {
        "key": "previewOnHover",
        "type": "bool",
        "label": "Show a window list when hovering a running app"
      },
      {
        "key": "showAddButton",
        "type": "bool",
        "label": "Show the + button for pinning apps"
      },
      {
        "key": "showRunningApps",
        "type": "bool",
        "label": "Also show open apps that are not pinned"
      }
    ]
  }
}
